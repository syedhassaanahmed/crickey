# Inspect settings for the evals: uv run --env-file evals/inspect.env inspect eval ... (README).
# Settings only. Never put API keys here.

# A CPU can take longer than Inspect's 10-minute default to read the first prompt (R17).
INSPECT_HTTP_REQUEST_TIMEOUT=3600
INSPECT_LOG_DIR=evals/logs
INSPECT_LOG_FORMAT=json
